# Supabase project settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Supabase project settings -> Database -> Connection string -> Transaction pooler
# Port 6543. Append ?pgbouncer=true
# A literal % in the password must be written as %25, or the driver mis-parses
# the URL. Do not keep the [ ] brackets from Supabase's placeholder.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
